{
  "version": "v1",
  "hooks": [
    {
      "name": "Secret Scan on Write",
      "trigger": "PreToolUse",
      "description": "Block writes that embed secrets (AWS keys, private keys, tokens)",
      "matcher": "fs_write|str_replace|fs_append",
      "action": {
        "type": "command",
        "command": "node .kiro/scripts/secret-scan.mjs",
        "timeout": 30
      }
    }
  ]
}