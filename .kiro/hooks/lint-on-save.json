{
  "version": "v1",
  "hooks": [
    {
      "name": "Lint on Save",
      "trigger": "PostFileSave",
      "description": "Run oxlint when JS/JSX/TS/TSX files are saved",
      "matcher": "\\.(jsx?|tsx?)$",
      "action": {
        "type": "command",
        "command": "npm.cmd run lint",
        "timeout": 60
      }
    }
  ]
}